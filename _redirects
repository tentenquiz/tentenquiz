# =====================================================================
# Cloudflare Pages 리다이렉트 설정
#
# ★ 매우 중요 — 하지 말아야 할 것 ★
# /about.html, /guide.html, /contact.html, /privacy.html, /terms.html 을
# /ko/about/ 같은 언어 경로로 리다이렉트하면 안 됩니다.
# 이 legacy 경로들은 build-multilingual-seo.js 의 pageDefinitions[].legacyPath
# 이며, 사이트맵과 모든 페이지의 hreflang="x-default" 타깃입니다.
# 리다이렉트하면 x-default 가 깨져 12개 언어 hreflang 클러스터가 전부
# 무효화됩니다. 반드시 200으로 그대로 서빙되어야 합니다.
#
# 참고: Pages 는 /ja/about → /ja/about/ 디렉터리 정규화를 기본 제공하므로
#       firebase.json 의 trailingSlash:true 를 대체할 규칙은 불필요합니다.
#       (배포 후 curl -I 로 실제 동작을 한 번 확인하세요.)
# =====================================================================

# ---------- www → apex 정규화 ----------
# Cloudflare 대시보드의 Redirect Rule 로 처리해도 되지만,
# 설정을 저장소 안에 함께 두는 편이 추적하기 쉽습니다.
https://www.tentenquiz.com/*  https://tentenquiz.com/:splat  301

# ---------- Pages 기본 도메인 → 커스텀 도메인 ----------
# *.pages.dev 가 색인되어 중복 콘텐츠가 되는 것을 막습니다.
# 프리뷰 배포에서도 걸리므로, 프리뷰로 QA 중이라면 이 두 줄을 잠시 주석 처리하세요.
https://tentenquiz.pages.dev/*  https://tentenquiz.com/:splat  301

# ---------- 언어 슬러그 오탈자 흡수 ----------
# global-config.js 는 zh-CN → 'zh-cn', zh-TW → 'zh-tw' 슬러그를 쓰는데
# 외부 링크가 언더스코어 형태로 들어오는 경우가 있습니다.
/zh_cn/*  /zh-cn/:splat  301
/zh_tw/*  /zh-tw/:splat  301

# ---------- 404 ----------
# Pages 는 출력 루트의 404.html 을 자동으로 사용하므로 별도 규칙이 필요 없습니다.
